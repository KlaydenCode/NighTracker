# URL du projet Supabase.
# Local : http://127.0.0.1:54321 (affichée par `npx supabase start`). Distant : tableau de bord Supabase.
# Ne jamais ajouter de clé service_role / secrète dans ce projet.
NUXT_PUBLIC_SUPABASE_URL=
# Clé PUBLIQUE (anon ou sb_publishable_...), jamais la clé service_role.
NUXT_PUBLIC_SUPABASE_KEY=
